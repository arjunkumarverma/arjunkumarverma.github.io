<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 400 400" width="100%" height="100%">
  <defs>
    <linearGradient id="bgGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#0f172a" />
      <stop offset="50%" stop-color="#1e293b" />
      <stop offset="100%" stop-color="#020617" />
    </linearGradient>
    <linearGradient id="goldGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#f59e0b" />
      <stop offset="100%" stop-color="#b45309" />
    </linearGradient>
    <radialGradient id="glow" cx="50%" cy="40%" r="60%">
      <stop offset="0%" stop-color="#38bdf8" stop-opacity="0.15" />
      <stop offset="100%" stop-color="#0f172a" stop-opacity="0" />
    </radialGradient>
  </defs>

  <!-- Background -->
  <rect width="400" height="400" fill="url(#bgGrad)" />
  <circle cx="200" cy="180" r="140" fill="url(#glow)" />

  <!-- Outer Decorative Ring -->
  <circle cx="200" cy="200" r="185" fill="none" stroke="#334155" stroke-width="1.5" stroke-dasharray="6,4" />
  <circle cx="200" cy="200" r="176" fill="none" stroke="url(#goldGrad)" stroke-width="1.5" />

  <!-- Stylized Executive Portrait Silhouette -->
  <!-- Suit / Shoulders -->
  <path d="M 90 380 C 95 305 130 270 170 255 L 200 290 L 230 255 C 270 270 305 305 310 380 Z" fill="#1e293b" stroke="#475569" stroke-width="2" />
  <!-- Shirt Collar & Tie -->
  <polygon points="175,257 200,290 190,257" fill="#f8fafc" />
  <polygon points="225,257 200,290 210,257" fill="#f8fafc" />
  <polygon points="194,260 206,260 203,340 197,340" fill="#dc2626" />
  <polygon points="190,257 210,257 205,275 195,275" fill="#991b1b" />

  <!-- Head / Neck -->
  <rect x="186" y="225" width="28" height="40" rx="4" fill="#fcd34d" opacity="0.85" />
  <ellipse cx="200" cy="175" rx="55" ry="68" fill="#fcd34d" opacity="0.85" />

  <!-- Hair -->
  <path d="M 142 165 C 140 115 170 100 200 100 C 235 100 260 118 258 165 C 255 135 240 115 200 115 C 165 115 145 138 142 165 Z" fill="#1e293b" />

  <!-- Spectacles / Eyeglasses -->
  <rect x="156" y="162" width="36" height="24" rx="4" fill="none" stroke="#0f172a" stroke-width="3" />
  <rect x="208" y="162" width="36" height="24" rx="4" fill="none" stroke="#0f172a" stroke-width="3" />
  <line x1="192" y1="172" x2="208" y2="172" stroke="#0f172a" stroke-width="3" />
  <line x1="146" y1="170" x2="156" y2="170" stroke="#0f172a" stroke-width="2.5" />
  <line x1="244" y1="170" x2="254" y2="170" stroke="#0f172a" stroke-width="2.5" />

  <!-- Eyes behind glasses -->
  <ellipse cx="174" cy="174" rx="4" ry="3" fill="#0f172a" />
  <ellipse cx="226" cy="174" rx="4" ry="3" fill="#0f172a" />

  <!-- Moustache -->
  <path d="M 175 204 C 185 200 195 201 200 205 C 205 201 215 200 225 204 C 220 213 205 214 200 210 C 195 214 180 213 175 204 Z" fill="#1e293b" />

  <!-- Gentle Smile -->
  <path d="M 188 217 Q 200 224 212 217" fill="none" stroke="#78350f" stroke-width="2" stroke-linecap="round" />

  <!-- Seal Inscription -->
  <text x="200" y="380" text-anchor="middle" font-family="'Georgia', serif" font-size="11" font-weight="bold" fill="#f59e0b" letter-spacing="2">DR. ARJUN KUMAR VERMA, PH.D</text>
</svg>
